              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Tanpa token. Login dengan kodenusantara@example.com (PROVIDER). Token disimpan ke `tokenProvider`.",
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
