# Copy to .env, then change the values for your machine
# One setting per line; no quotes, no "export", comments on their own line

# Docker (default)
DB_PORT=3306
DB_USERNAME=camphub_user
DB_PASSWORD=camphub_dev_password
MYSQL_ROOT_PASSWORD=root_dev_password

# XAMPP, Laragon, or native MySQL (replace the three DB_ lines above):
# use the MySQL port shown in XAMPP/Laragon (usually 3306)
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=

# Generate your own value: openssl rand -hex 32
JWT_SECRET=ganti-dengan-hasil-openssl-rand-hex-32
ADMIN_PASSWORD=admin_dev_password
